NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/projects
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-only verified email of the sole app administrator. Required for private access.
NAKAMA_ADMIN_EMAIL=

# Structured backend logs: debug | info (default) | warn | error | silent.
NAKAMA_LOG_LEVEL=info
# Local JSONL path (default .nakama/logs/backend.jsonl); "off" disables the file.
# Vercel always uses stdout/stderr; local file persistence is disabled there.
NAKAMA_LOG_FILE=
