{
  "name": "nakama",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/check.ts dev",
    "build": "tsx scripts/check.ts build",
    "start": "tsx scripts/check.ts start",
    "typecheck": "tsx scripts/check.ts typecheck",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "db:types": "tsx scripts/database-types.ts",
    "db:check": "tsx scripts/database-types.ts --check",
    "db:local": "tsx scripts/local-database.ts",
    "db:verify-local": "tsx scripts/check-local-integrity.ts",
    "logs": "node --env-file-if-exists=.env.local --import tsx scripts/logs.ts",
    "logs:pull": "node --env-file-if-exists=.env.local --import tsx scripts/pull-logs.ts",
    "logs:check-bundle": "tsx scripts/check-log-bundle.ts",
    "typecheck:explain": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clerk/localizations": "4.24.0",
    "@clerk/nextjs": "7.9.19",
    "@vercel/functions": "^3.0.0",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.49",
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
