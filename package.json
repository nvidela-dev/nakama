{
  "name": "nakama",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/check.ts dev",
    "build": "tsx scripts/check.ts build",
    "start": "tsx scripts/check.ts start",
    "typecheck": "tsx scripts/check.ts typecheck",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "db:types": "tsx scripts/database-types.ts",
    "db:check": "tsx scripts/database-types.ts --check",
    "db:local": "tsx scripts/local-database.ts",
    "db:verify-local": "tsx scripts/check-local-integrity.ts",
    "logs": "node --env-file-if-exists=.env.local --import tsx scripts/logs.ts",
    "logs:pull": "node --env-file-if-exists=.env.local --import tsx scripts/pull-logs.ts",
    "logs:check-bundle": "tsx scripts/check-log-bundle.ts",
    "typecheck:explain": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "flows:catalog": "tsx scripts/flow-catalog.ts",
    "flows:check": "tsx scripts/flow-catalog.ts --check",
    "lint": "eslint src .storybook --max-warnings 0",
    "format": "prettier --write src scripts tests e2e .storybook *.ts *.mjs",
    "format:check": "prettier --check src scripts tests e2e .storybook *.ts *.mjs",
    "architecture:check": "tsx scripts/check-architecture.ts",
    "test:components": "playwright test --config playwright.components.config.ts",
    "prebuild": "npm run architecture:check && npm run flows:check",
    "pretypecheck": "npm run architecture:check && npm run flows:check",
    "frontend:measure": "tsx scripts/frontend-metrics.ts",
    "frontend:report": "tsx scripts/frontend-metrics.ts --static",
    "test:frontend": "playwright test --config playwright.frontend.config.ts",
    "frontend:check-bundle": "tsx scripts/check-frontend-bundle.ts",
    "postbuild": "npm run frontend:check-bundle"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clerk/localizations": "4.24.0",
    "@clerk/nextjs": "7.9.19",
    "@vercel/functions": "^3.0.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clerk/testing": "^2.2.49",
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "7.3.7"
  },
  "type": "module"
}
